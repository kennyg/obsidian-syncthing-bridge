{
	"name": "obsidian-syncthing-bridge",
	"version": "0.1.0",
	"description": "Manage Syncthing-powered remote vault sync from within Obsidian",
	"main": "main.js",
	"type": "module",
	"scripts": {
		"dev": "vite build --watch",
		"build": "tsc -noEmit -skipLibCheck && vite build --mode production"
	},
