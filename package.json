		"syncthing",
		"sync",
		"remote",
		"vault"
	],
	"license": "MIT",
	"devDependencies": {
		"@types/node": "^22.19.17",
		"tslib": "2.4.0",
		"typescript": "^5.8.3",
		"vite": "^8.1.6"
	},
	"dependencies": {
		"obsidian": "latest"
	}
}
